# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma7.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# PENTING: file ini di-track git. JANGAN isi dengan kredensial asli.
# Salin ke `.env` (sudah di-gitignore), lalu isi nilai aslinya di sana.

# Supabase transaction pooler (port 6543) - dipakai aplikasi saat runtime.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase session pooler / direct (port 5432) - dipakai Prisma CLI (db push, migrate, studio).
# Wajib diisi: `prisma db push` gagal kalau lewat transaction pooler.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

BETTER_AUTH_SECRET="your-super-secret-key-change-me"
BETTER_AUTH_URL="http://localhost:3000"

# Base URL situs - dipakai sitemap.xml, robots.txt, dan metadataBase.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase Storage - upload gambar sampul artikel dari admin panel.
#
# SUPABASE_URL           : URL project (Project Settings > Data API),
#                          contoh https://abcdefgh.supabase.co
#                          Akhiran /rest/v1 boleh ikut tercopy - otomatis
#                          dipotong di src/lib/supabaseStorage.ts.
# SUPABASE_SERVICE_ROLE_KEY : secret key dari Project Settings > API Keys.
#                          Boleh format baru (sb_secret_...) maupun service_role
#                          JWT lama. RAHASIA, melewati RLS. Jangan pernah diberi
#                          prefix NEXT_PUBLIC_ - key dengan prefix itu ikut
#                          ter-bundle ke browser, artinya bocor ke pengunjung.
#                          Jangan pakai publishable/anon key: tidak boleh upload.
# SUPABASE_STORAGE_BUCKET: nama bucket, buat manual di menu Storage.
#                          WAJIB dicentang "Public bucket": URL yang disimpan ke
#                          tabel Media adalah URL publik (.../object/public/...),
#                          dan di bucket private URL itu dijawab 400.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="article-images"

# Akun admin yang dibuat `npm run db:seed`. Hanya untuk development.
# SEED_ADMIN_PASSWORD minimal 8 karakter; kalau dibiarkan kosong, seed
# melewati pembuatan admin tanpa error.
SEED_ADMIN_EMAIL="admin@dailyhotnews.test"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Admin"
